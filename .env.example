# Atoms Webhook Secrets (comma-separated for key rotation)
ATOMS_WEBHOOK_SECRETS=your_webhook_signing_secret_here

# Smallest AI API Key (required only for real-mode API backfill and validation experiments)
SMALLEST_API_KEY=your_smallest_ai_api_key_here

# SQLite Database path (defaults to :memory: if unset)
LEDGER_DB_PATH=:memory:

# Retention window in seconds (docs: 1 hour to 30 days; default: 86400)
RETENTION_WINDOW_SECONDS=86400

# Required events for a call to be complete
REQUIRED_EVENTS=post-conversation,analytics-completed

# Statuses where analytics-completed is expected (UNVALIDATED default: completed)
ANALYTICS_EXPECTED_STATUSES=completed

# Analytics arrival grace window in seconds
ANALYTICS_GRACE_SECONDS=600

# Post reorder grace window in seconds
POST_REORDER_GRACE_SECONDS=60

# Max duration before uncompleted call with only pre-conversation is considered overdue
MAX_CALL_SECONDS=3600

# Maximum request body size in bytes (10 MB)
MAX_BODY_BYTES=10485760
